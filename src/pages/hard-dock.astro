---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { marina, fullAddress, mapsUrl } from '../data/marina';
const r = marina.restaurant;
---
<Base title={r.name} description={`${r.name} at Riverwalk Marina: casual American food, seafood and drinks on a big deck over the Tennessee River in Decatur, Alabama. Arrive by car or by boat.`}>
  <PageHero eyebrow="Dining on the water" title={`${r.name} at Riverwalk Marina`} lead={r.tagline + '.'} />

  <section class="section">
    <div class="container split">
      <div>
        <h2>A deck on the river and a bar with a Key West feel.</h2>
        <p class="lead">{r.description}</p>
        <ul class="check-list">
          <li>Indoor dining and a large open-air deck over the water</li>
          <li>Burgers, sandwiches, wings and fresh seafood</li>
          <li>Full bar with cold beer and cocktails</li>
          <li>Live music and events through the season</li>
          <li>Boat-up dining: tie off at the restaurant dock</li>
        </ul>
        <div class="btn-row mt-2">
          <a class="btn btn--primary" href={`tel:${r.phoneHref}`}><Icon name="phone" class="btn-icon" /> {r.phone}</a>
          <a class="btn btn--outline" href={mapsUrl} target="_blank" rel="noopener">Directions</a>
        </div>
      </div>
      <div class="card hours-card">
        <div class="icon"><Icon name="clock" /></div>
        <h3>Hours</h3>
        <table class="hours">
          {r.hours.map((h) => (<tr><td>{h.days}</td><td>{h.close ? `${h.open} – ${h.close}` : h.open}</td></tr>))}
        </table>
        <p class="muted" style="margin-top:.9rem;font-size:.92rem">{r.hoursNote}</p>
        <p class="muted" style="font-size:.92rem;margin-bottom:0">{fullAddress}. The restaurant is at the back of the marina property, past the ship store.</p>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container grid grid--3">
      <div><h3>Arriving by boat</h3><p class="muted">Look for the restaurant dock at the back of the harbor. Space is first come, first served. Please keep the fuel dock clear.</p></div>
      <div><h3>Groups and events</h3><p class="muted">Planning a birthday, team outing or rehearsal dinner? Call the restaurant to talk about group seating on the deck.</p></div>
      <div><h3>Sunset tip</h3><p class="muted">The deck faces west over the water. Arrive an hour before sunset for the best seat on the river.</p></div>
    </div>
  </section>

  <CallToAction title="Make a night of it." text={`Call the ${r.name} at ${r.phone} for tonight's specials and live music schedule.`} />
</Base>

<style>
  .hours-card h3 { font-size: 1.6rem; }
</style>
