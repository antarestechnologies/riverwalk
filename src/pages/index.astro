---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Icon from '../components/Icon.astro';
import CallToAction from '../components/CallToAction.astro';
import { marina, fullAddress, mapsUrl } from '../data/marina';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
const yearsServing = new Date().getFullYear() - marina.established;

// Only render the <video> when the file is actually present in /public.
const inPublic = (p: string) => existsSync(fileURLToPath(new URL(`../../public${p}`, import.meta.url)));
const hasVideo = inPublic(marina.hero.video);
const hasWebm = inPublic(marina.hero.videoWebm);
const hasPoster = inPublic(marina.hero.poster);
---
<Base title="Home" home>
  <section class="hero" data-video={hasVideo ? 'true' : undefined}>
    <HeroScene />
    {hasVideo && (
      <video
        class="hero-video"
        autoplay muted loop playsinline preload="metadata"
        poster={hasPoster ? marina.hero.poster : undefined}
        aria-hidden="true" tabindex="-1"
      >
        {hasWebm && <source src={marina.hero.videoWebm} type="video/webm" />}
        <source src={marina.hero.video} type="video/mp4" />
      </video>
    )}
    <div class="container hero-inner">
      <img class="hero-logo" src="/images/logo.png" alt="" width="353" height="352" loading="eager" decoding="async" fetchpriority="high" />
      <h1 class="visually-hidden">{marina.name}</h1>
      <p class="hero-title">{marina.tagline}</p>
      <p class="lead">
        Full-service marina on the Tennessee River with covered and open slips, fuel dock, boat ramp,
        ship store, repair service and rentals, minutes from downtown Decatur.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/slips/">Find a slip</a>
        <a class="btn btn--ghost" href={marina.phone.mainHref}><Icon name="phone" class="btn-icon" /> {marina.phone.main}</a>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <dl class="facts">
        <div class="fact"><dt>Marina hours</dt><dd>{marina.hours.marina[0].days}, {marina.hours.marina[0].open} – {marina.hours.marina[0].close}</dd></div>
        <div class="fact"><dt>Location</dt><dd>{marina.water.mileMarker}</dd></div>
        <div class="fact"><dt>Depth</dt><dd>{marina.water.approachDepth} approach & dockside</dd></div>
        <div class="fact"><dt>Fuel on the dock</dt><dd>{marina.fuel.items.map((f, i) => (<>{i > 0 && ' · '}{f.label} ${f.price.toFixed(2)}</>))}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Everything in one place</span>
        <h2>Fuel up, launch, store, fix, rent.</h2>
        <p class="lead">Whether you keep your boat here year-round or are passing through on the river, we have what you need.</p>
      </div>
      <div class="grid grid--3">
        {marina.services.map((s) => (
          <a class="card card--link" href={s.slug === 'storage' ? '/slips/' : s.slug === 'rentals' ? '/rentals/' : `/services/#${s.slug}`}>
            <div class="icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <p class="more">Learn more →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <span class="eyebrow">Slips & storage</span>
        <h2>{marina.slips.total} slips, covered and open, with room for sailboats.</h2>
        <p>
          Floating docks, {marina.water.docksideDepth} of water at the slip, shore power and fresh water. Sailboats are
          welcome on C-Dock, where open slips give masts plenty of clearance. Transient dockage is available for boaters
          cruising the Tennessee River.
        </p>
        <ul class="check-list">
          {marina.slips.types.map((t) => <li>{t}</li>)}
        </ul>
        <div class="btn-row mt-2">
          <a class="btn btn--primary" href="/slips/">Slip details</a>
          <a class="btn btn--outline" href="/visit/#contact">Ask about availability</a>
        </div>
      </div>
      <div class="stat-block">
        <div class="stat"><span class="num">{marina.slips.total}</span><span class="lbl">Wet slips</span></div>
        <div class="stat"><span class="num">{marina.slips.sailboatSlips}</span><span class="lbl">Sailboat slips on C-Dock</span></div>
        <div class="stat"><span class="num">{marina.water.docksideDepth}</span><span class="lbl">Dockside depth</span></div>
        <div class="stat"><span class="num">{yearsServing}+</span><span class="lbl">Years on the river</span></div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split split--rev">
      <div class="dock-card">
        <div class="icon"><Icon name="paddle" /></div>
        <h3>Rentals</h3>
        <p class="muted">Pontoons, kayaks, canoes and paddleboards</p>
        <ul class="check-list">
          {marina.rentals.map((r) => <li>{r.title}</li>)}
          <li>Life jackets and paddles included</li>
          <li>Hourly, half-day and full-day rates</li>
        </ul>
        <p class="muted" style="margin-top:.9rem;font-size:.9rem;margin-bottom:0">Reserve by phone. Summer weekends fill up fast.</p>
      </div>
      <div>
        <span class="eyebrow">No boat? No problem.</span>
        <h2>Rent a pontoon or a paddleboard and explore Wheeler Lake.</h2>
        <p>
          Spend the day cruising the lake on a pontoon with the whole crew, or take a kayak, canoe or paddleboard out
          to the quiet backwaters around the marina. Everything you need is included and we will walk you through it.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/rentals/">Rental details</a>
          <a class="btn btn--outline" href={marina.phone.mainHref}>{marina.phone.main}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Getting here</span>
        <h2>Minutes from downtown Decatur and I-65.</h2>
        <p>
          You will find us on Highway 31 at the foot of the Hudson Memorial Bridge, where the river meets the city.
          By water, look for us at {marina.water.mileMarker} on Wheeler Lake.
        </p>
        <dl class="drive">
          {marina.driving.map((d) => (<div><dt>{d.from}</dt><dd>{d.time}</dd></div>))}
        </dl>
        <div class="btn-row mt-2">
          <a class="btn btn--primary" href={mapsUrl} target="_blank" rel="noopener"><Icon name="pin" class="btn-icon" /> Get directions</a>
          <a class="btn btn--outline" href="/visit/">Visit & contact</a>
        </div>
      </div>
      <div class="addr-card">
        <Icon name="pin" />
        <p class="addr">{fullAddress}</p>
        <p class="muted">{marina.address.landmark}</p>
      </div>
    </div>
  </section>

  <CallToAction />
</Base>

<script>
  // Safari sometimes leaves a muted autoplay video paused (Low Power Mode,
  // per-site Auto-Play settings, or the poster winning the race). Set the
  // properties explicitly and ask it to play once it can.
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    const tryPlay = () => video.play().catch(() => {});
    if (video.readyState >= 2) tryPlay();
    video.addEventListener('canplay', tryPlay, { once: true });
    document.addEventListener('visibilitychange', () => { if (!document.hidden && video.paused) tryPlay(); });
    document.addEventListener('touchstart', tryPlay, { once: true, passive: true });
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; color: #fff; min-height: min(82vh, 760px); display: flex; align-items: center; text-align: center; }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .hero-video { display: none; } }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse at center, rgba(11,31,51,.62) 0%, rgba(11,31,51,.42) 55%, rgba(11,31,51,.3) 100%); }
  .hero-inner { position: relative; z-index: 2; padding-block: clamp(3rem, 8vw, 5rem); max-width: 760px; margin-inline: auto; display: flex; flex-direction: column; align-items: center; }
  .hero-logo { width: clamp(180px, 26vw, 260px); height: auto; filter: drop-shadow(0 6px 24px rgba(0,0,0,.35)); margin-bottom: 1.25rem; }
  .hero-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.7rem, 3.6vw, 2.6rem); line-height: 1.15; color: #fff; text-shadow: 0 2px 20px rgba(0,0,0,.3); margin: 0 0 .75rem; letter-spacing: -0.01em; }
  .hero .lead { color: #e2ecf3; margin-inline: auto; }
  .hero .btn-row { justify-content: center; }
  @media (max-width: 700px) {
    .hero::before { background: linear-gradient(180deg, rgba(11,31,51,.5) 0%, rgba(11,31,51,.62) 50%, rgba(11,31,51,.8) 100%); }
  }

  .stat-block { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .stat { background: var(--navy-900); color: #fff; border-radius: var(--radius); padding: 1.5rem; display: grid; gap: .25rem; }
  .stat .num { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; line-height: 1; color: #ffd08a; }
  .stat .lbl { color: #b8c9d7; font-size: .95rem; }

  .dock-card { background: var(--surface); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow); }
  .dock-card h3 { font-size: 1.8rem; margin-top: 1rem; margin-bottom: .2rem; }

  .drive { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem 1.5rem; margin: 1.5rem 0 0; }
  .drive div { border-top: 2px solid var(--river-100); padding-top: .5rem; }
  .drive dt { font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; color: var(--ink-500); font-weight: 700; }
  .drive dd { margin: 0; font-weight: 600; }

  .addr-card { background: var(--navy-900); color: #fff; border-radius: var(--radius); padding: 2.5rem; display: grid; gap: .5rem; }
  .addr-card :global(svg) { width: 40px; height: 40px; color: #ffd08a; }
  .addr-card .addr { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; margin: .5rem 0 0; }
  .addr-card .muted { color: #b8c9d7; }
</style>
