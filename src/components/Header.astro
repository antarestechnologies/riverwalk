---
import { marina, nav } from '../data/marina';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${marina.name} home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="20" cy="9" r="4"/><path d="M20 13v20"/><path d="M9 22H5a15 15 0 0 0 30 0h-4"/><path d="M15 22h10"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{marina.name}</span>
        <span class="brand-sub">Decatur, Alabama</span>
      </span>
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary nav-cta" href={marina.phone.mainHref}>
        <Icon name="phone" class="btn-icon" /> {marina.phone.main}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) btn?.click();
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--sand-100);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--navy-900); }
  .brand-mark { width: 42px; height: 42px; border-radius: 12px; background: var(--navy-900); color: #fff; display: grid; place-items: center; }
  .brand-mark svg { width: 26px; height: 26px; }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-name { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .brand-sub { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-500); font-weight: 600; }

  .site-nav { display: flex; align-items: center; gap: 1.5rem; }
  .site-nav ul { list-style: none; display: flex; gap: 0.25rem; margin: 0; padding: 0; }
  .site-nav a:not(.btn) {
    display: block; padding: 0.55rem 0.8rem; border-radius: 999px; text-decoration: none;
    color: var(--ink-700); font-weight: 600; font-size: 0.95rem; white-space: nowrap;
  }
  .site-nav a:not(.btn):hover { background: var(--sand-200); color: var(--navy-900); }
  .site-nav a[aria-current="page"] { color: var(--navy-900); background: var(--sand-300); }
  .nav-cta { padding: 0.65rem 1.1rem; font-size: 0.95rem; white-space: nowrap; }
  :global(.btn-icon) { width: 18px; height: 18px; }

  .nav-toggle { display: none; background: none; border: 0; width: 44px; height: 44px; padding: 10px; cursor: pointer; }
  .nav-toggle span { display: block; height: 2px; background: var(--navy-900); margin: 5px 0; transition: transform .2s, opacity .2s; }

  @media (max-width: 1080px) {
    .nav-toggle { display: block; }
    .site-nav {
      position: fixed; inset: 72px 0 0 0; background: var(--sand-100); flex-direction: column; align-items: stretch;
      padding: 1.25rem var(--gutter) 2rem; gap: 1rem; transform: translateX(100%); visibility: hidden;
      transition: transform .25s ease, visibility 0s linear .25s;
      overflow-y: auto;
    }
    .site-nav.is-open { transform: none; visibility: visible; transition: transform .25s ease, visibility 0s; }
    .site-nav ul { flex-direction: column; gap: 0.25rem; }
    .site-nav a:not(.btn) { font-size: 1.15rem; padding: 0.85rem 1rem; }
    .nav-cta { justify-content: center; }
    .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    :global(body.nav-open) { overflow: hidden; }
  }
</style>
